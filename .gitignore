PLAN.md
*.html
!web/index.html

# ── Frontend (built later) ───────────────────────────────────────────────────
frontend/node_modules
frontend/dist
web/node_modules
web/dist

# ── OS / editors ─────────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
