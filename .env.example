# ═══════════════════════════════════════════════════════════════════════════
# keystone — Server Environment Template (v1)
# Collected end-to-end from the HrX codebase (August 10, 2026).
# Every variable below is either:
#   [HrX]   inherited from HR Shakti as-is
#   [RENAMED] renamed from HrX for clarity
#   [NEW]    introduced by keystone
#   (dropped) HrX vars NOT carried over — see report §4
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development                    # [HrX] development | production | test
PORT=4000                               # [HrX] API listen port
HOST=0.0.0.0                            # [HrX] bind host
RUST_LOG=info,keystone=debug               # [NEW] tracing filter (replaces nothing)

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgres://keystone:keystone_dev@localhost:5432/keystone   # [HrX] pg connection string
DATABASE_MAX_CONNECTIONS=10             # [NEW] sqlx pool size
PG_CONNECTION_TIMEOUT_MS=30000          # [HrX] connect timeout (default 30s)
TEST_DATABASE_URL=postgres://keystone:keystone_test@localhost:5432/keystone_test   # [NEW] integration tests (CI provides Postgres)

# ── JWT (HS256) ──────────────────────────────────────────────────────────────
# [NEW] v1 signs HS256: a shared secret >= 32 bytes. REQUIRED — the API
# refuses to boot without one. Dev: openssl rand -base64 48
# Upgrade path to asymmetric is documented in crates/auth/src/jwt.rs.
JWT_PRIVATE_KEY_B64=                    # [NEW] base64-encoded secret (>=32 bytes)
JWT_PRIVATE_KEY_PATH=                   # [NEW] file fallback containing base64
JWT_ACCESS_EXPIRATION=900               # [HrX] access token TTL (seconds)
JWT_REFRESH_EXPIRATION=604800           # [HrX] refresh token TTL (seconds)
JWT_ISSUER=keystone                        # [HrX] token issuer claim
JWT_AUDIENCE=keystone-api                  # [HrX] token audience claim (undocumented in HrX)

# ── Password hashing (Argon2id) ──────────────────────────────────────────────
ARGON2_MEMORY=65536                     # [HrX] memory cost (KiB)
ARGON2_ITERATIONS=3                     # [HrX] time cost
ARGON2_PARALLELISM=4                    # [HrX] threads

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                       # [HrX]
GOOGLE_CLIENT_SECRET=                   # [HrX]
LINKEDIN_CLIENT_ID=                     # [HrX]
LINKEDIN_CLIENT_SECRET=                 # [HrX]
MICROSOFT_CLIENT_ID=                    # [HrX]
MICROSOFT_CLIENT_SECRET=                # [HrX]
MICROSOFT_TENANT_ID=common              # [HrX] used by code, was undocumented

# ── Mail (SMTP / lettre) ─────────────────────────────────────────────────────
SMTP_HOST=                              # [HrX]
SMTP_PORT=587                           # [HrX]
SMTP_USER=                              # [HrX]
SMTP_PASS=                              # [HrX]
SMTP_FROM=noreply@keystone.app             # [HrX]

# ── Object storage (S3 / MinIO) — REAL in keystone ──────────────────────────────
# [HrX] these existed in .env.example but were never used by any code.
# keystone implements actual uploads via aws-sdk-rust (presigned PUT/GET).
S3_ENDPOINT=http://localhost:9000       # [HrX] MinIO local; AWS S3 in prod
S3_REGION=us-east-1                     # [HrX]
S3_ACCESS_KEY=keystone                     # [HrX]
S3_SECRET_KEY=keystone_dev                 # [HrX]
S3_BUCKET=keystone-uploads                 # [HrX]
S3_FORCE_PATH_STYLE=true                # [NEW] required for MinIO

# ── LLM (OpenAI-compatible, Groq) ────────────────────────────────────────────
# [HrX] used by code (llm.service.ts) but missing from .env.example — now documented
LLM_API_KEY=                            # [HrX]
LLM_BASE_URL=https://api.openai.com/v1  # [HrX] default; Groq https://api.groq.com/openai/v1
LLM_MODEL=gpt-4o-mini                   # [HrX] default

# ── App / CORS ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173           # [HrX] public frontend URL
API_URL=http://localhost:4000           # [HrX] public API URL
CORS_ORIGINS=                           # [HrX] comma-separated extra origins (was undocumented)
APP_POST_LOGIN_REDIRECT=                # [NEW] where OAuth logins land (default: APP_URL/)

# ── OAuth (Google) ───────────────────────────────────────────────────────────
# OAuth is DISABLED until BOTH client id and secret are set. Credentials will
# be generated fresh before production (no legacy HrX secrets are reused).
# Endpoints are overridable so tests point at a local mock provider.
OAUTH_GOOGLE_CLIENT_ID=                 # [NEW]
OAUTH_GOOGLE_CLIENT_SECRET=             # [NEW]
OAUTH_GOOGLE_REDIRECT_URI=              # [NEW] default: {API_URL}/api/v1/auth/oauth/google/callback
OAUTH_GOOGLE_AUTH_URL=                  # [NEW] default: Google accounts auth endpoint
OAUTH_GOOGLE_TOKEN_URL=                 # [NEW] default: Google token endpoint
OAUTH_GOOGLE_USERINFO_URL=              # [NEW] default: Google OpenID userinfo endpoint
OAUTH_GOOGLE_SCOPES=                    # [NEW] default: openid email profile

# ── Storage (uploads) ───────────────────────────────────────────────────────
# memory keeps uploads in-process (dev/tests, lost on restart); s3 uses the
# standard AWS_* variables below with MinIO/S3-compatible endpoints.
STORAGE_BACKEND=memory                     # [NEW] memory | s3
STORAGE_BUCKET=keystone                    # [NEW] bucket for s3 backend
AWS_ACCESS_KEY_ID=                         # [NEW] required when STORAGE_BACKEND=s3
AWS_SECRET_ACCESS_KEY=                     # [NEW] required when STORAGE_BACKEND=s3
AWS_REGION=us-east-1                       # [NEW] default region
AWS_ENDPOINT_URL_S3=                       # [NEW] optional; MinIO local endpoint

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=                             # [HrX] optional
OTEL_EXPORTER_OTLP_ENDPOINT=            # [NEW] optional OTLP tracing endpoint

# ─────────────────────────────────────────────────────────────────────────────
# DROPPED from HrX (see report §4):
#   REDIS_URL            — Redis never used by any code; v1 has no cache dependency
#   ELASTICSEARCH_URL    — v1 search is Postgres FTS; ES optional via SearchBackend trait
#   DATABASE_DRIVER      — Neon "serverless" experiment; keystone uses sqlx + pg directly
#   OPENAI_API_KEY       — folded into LLM_API_KEY (HrX used it as a fallback)
# ─────────────────────────────────────────────────────────────────────────────
