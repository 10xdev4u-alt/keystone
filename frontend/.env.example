# ═══════════════════════════════════════════════════════════════════════════
# keystone — Frontend Environment Template (v1)
# Collected end-to-end from the HrX frontend (August 10, 2026).
# Frontend is rebuilt from scratch (new UI), API layer is 100% generated from
# the keystone OpenAPI spec — no hand-written API files, no drift.
# ═══════════════════════════════════════════════════════════════════════════

# ── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1   # [HrX] backend base URL (required)
VITE_WS_URL=ws://localhost:4000             # [HrX] websocket (chat) (required)
VITE_SSE_URL=http://localhost:4000/api/v1   # [NEW] SSE endpoint for notifications
VITE_APP_URL=http://localhost:5173          # [HrX] frontend self URL (required)

# ── OAuth (public client IDs only — secrets stay server-side) ───────────────
VITE_GOOGLE_CLIENT_ID=                      # [HrX]
VITE_LINKEDIN_CLIENT_ID=                    # [HrX]
VITE_MICROSOFT_CLIENT_ID=                   # [HrX]

# ── Observability ────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=                            # [HrX] optional
VITE_SENTRY_ENVIRONMENT=development         # [HrX]
VITE_SENTRY_RELEASE=                        # [HrX] build-time

# ── Analytics ────────────────────────────────────────────────────────────────
VITE_ANALYTICS_ID=                          # [HrX] optional
VITE_ANALYTICS_URL=                         # [HrX] optional

# ── Build info ───────────────────────────────────────────────────────────────
VITE_APP_VERSION=0.1.0                      # [HrX]
VITE_DEPLOYMENT_REGION=auto                 # [HrX]
VITE_COMMIT_SHA=                            # [HrX] injected by CI
VITE_GIT_BRANCH=                            # [HrX] injected by CI

# ─────────────────────────────────────────────────────────────────────────────
# DROPPED from HrX (see report §5):
#   VITE_FEATURE_FLAGS      — replaced by typed, compile-time feature gates in keystone
#   VITE_NEWSDATA_API_KEY   — third-party news feed API (deferred; news content
#   VITE_GUARDIAN_API_KEY     strategy re-decided with the rebuilt product)
#   VITE_FINNHUB_API_KEY
#   VITE_GNEWS_API_KEY
# ─────────────────────────────────────────────────────────────────────────────
