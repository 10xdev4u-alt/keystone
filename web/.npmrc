# openapi-typescript@7 declares a conservative `typescript@^5.x` peer range,
# but works correctly under the project's TypeScript 6 (it is a build-time
# dts generator; the generated output compiles clean under TS 6, verified in
# CI). legacy-peer-deps keeps `npm ci` (CI) and `npm install` (local) on the
# same resolution path instead of failing the install on the peer mismatch.
legacy-peer-deps=true
